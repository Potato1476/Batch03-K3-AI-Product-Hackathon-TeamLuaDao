<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sprint 02 permission budget. Deliberately absent and never to be added:
      READ_SMS/RECEIVE_SMS, READ_CONTACTS, READ_CALL_LOG, storage, and any
      accessibility service. Notification access is a system-bound service
      permission (no runtime dialog); the user must enable CHAN by hand in
      Android's Notification Access settings.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested contextually, only when the user enables Zalo protection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested contextually, only when the user taps the microphone button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility for the device's speech recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CHAN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CHAN">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receive shared plain text from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Receive a shared image from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Passive Zalo intake. Bound by the system only after the user grants
          Notification Access; `default_filter_types` keeps the OS from waking
          us for ongoing/silent notifications we would discard anyway.
        -->
        <service
            android:name=".notification.ZaloNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_access_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>
    </application>

</manifest>
