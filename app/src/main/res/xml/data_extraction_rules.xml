<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing CHAN keeps is worth moving off this device.

  The only durable state is the encrypted device token, the cached Rule Bundle,
  and two switches. The token is bound to an Android Keystore key that does not
  travel, so a restored copy would be unreadable anyway; re-issuing one is both
  cheaper and cleaner.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
