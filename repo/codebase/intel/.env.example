CHAN_DATABASE_URL=postgresql://chan:change-me@localhost:5432/chan

# Separate identities are required for report submission and review.
CHAN_INTEL_API_KEYS=report-ingest=replace-with-random-secret-one,intel-reviewer=replace-with-random-secret-two

# PhishTank requires a descriptive User-Agent. Include a monitored contact.
CHAN_INTEL_USER_AGENT=chan-threat-intel/ops@example.org

# Optional but recommended. Register a free PhishTank application key.
CHAN_PHISHTANK_APP_KEY=

# Keep false unless OpenPhish has granted suitable written/commercial rights.
CHAN_OPENPHISH_LICENSE_CONFIRMED=false

CHAN_INTEL_MAXIMUM_FEED_BYTES=33554432
CHAN_USER_REPORT_THRESHOLD=2

# Versioned client contract shared by Gateway, Detection and clients.
CHAN_LOOKUP_PREFIX_LENGTH=5
