{
  "name": "CHAN — Trợ lý chống lừa đảo",
  "short_name": "CHAN",
  "description": "Nhận ra dấu hiệu thao túng trước khi chuyển tiền.",
  "lang": "vi",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F5F8FE",
  "theme_color": "#26339E",
  "icons": [
    {
      "src": "/image.png",
      "sizes": "1180x944",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg"]
        }
      ]
    }
  }
}
