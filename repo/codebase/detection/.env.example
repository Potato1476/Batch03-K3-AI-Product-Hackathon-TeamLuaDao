# Detection reads active-model metadata from the private Training API.
CHAN_TRAINING_API_URL=http://localhost:8001
CHAN_TRAINING_API_KEY=replace-with-a-training-api-key
CHAN_INTEL_API_URL=http://localhost:8002
CHAN_DETECTION_API_KEY=replace-with-a-detection-api-key
CHAN_MODEL_POLL_SECONDS=60
CHAN_REQUEST_TIMEOUT_SECONDS=5

# Bootstrap local/demo khi Training Registry chưa có model promoted.
# Khi registry có active model, Detection tự chuyển sang model đó.
CHAN_BOOTSTRAP_MODEL_PATH=../ml/artifacts/chan-signal-model.joblib
CHAN_BOOTSTRAP_MODEL_SHA256=44a885db58d96d3b9dcd378504f9b329643fbfbd05518c8b146542fbd07e8445
CHAN_BOOTSTRAP_MODEL_VERSION=chan-signal-20260730
