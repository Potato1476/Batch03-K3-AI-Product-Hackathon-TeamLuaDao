# CHẮN public /v1 gateway — biến môi trường
# Sao chép thành .env rồi sửa. Không commit file .env.

# --- Bắt buộc ---------------------------------------------------------------
CHAN_DATABASE_URL=postgresql://chan:chan@localhost:5432/chan

# --- Rule Bundle ------------------------------------------------------------
# Bỏ trống khi chạy từ source: service tự tìm codebase/rules trong repo.
# Trong container, Dockerfile đã set CHAN_RULES_DIR=/app/rules.
# CHAN_RULES_DIR=/app/rules

# --- Cache / rate limit -----------------------------------------------------
# Bỏ trống thì bộ đếm chạy trong tiến trình (đủ cho demo 1 worker,
# KHÔNG đủ khi chạy nhiều worker — lúc đó phải có Redis).
CHAN_REDIS_URL=redis://localhost:6379/0

# --- CORS -------------------------------------------------------------------
# Origin của PWA. Bỏ trống = không bật CORS (Android/Zalo OA không cần).
CHAN_CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
CHAN_DEVICE_TOKEN_TTL_DAYS=90

# --- Rate limit (§7.3 — chống dùng /analyze như LLM proxy miễn phí) --------
CHAN_ANALYZE_PER_DEVICE_PER_MINUTE=20
CHAN_ANALYZE_PER_IP_PER_MINUTE=60
CHAN_LOOKUP_PER_DEVICE_PER_MINUTE=120
CHAN_REPORT_PER_DEVICE_PER_DAY=30

# --- L3: local | llm | ensemble --------------------------------------------
# local   = chỉ dùng model chan_ml (mặc định, offline, chi phí 0)
# llm     = gọi Claude, tự động fallback về local khi lỗi/timeout
# ensemble= chạy cả hai, max-pool theo từng dấu hiệu (ưu tiên recall)
CHAN_L3_PROVIDER=local
CHAN_LLM_MODEL=claude-sonnet-5
CHAN_LLM_TIMEOUT_SECONDS=8.0
# ANTHROPIC_API_KEY=sk-ant-...

# --- pgvector similarity ----------------------------------------------------
# Chỉ bật khi kho scenarios đã có embedding. beta=0 thì số hạng similarity
# biến mất khỏi công thức L4 thay vì làm lệch mọi điểm.
CHAN_SIMILARITY_ENABLED=false
CHAN_SIMILARITY_BETA=0.0

# --- OCR: stub | paddle -----------------------------------------------------
# stub trả 501 rõ ràng. paddle cần cài extra [ocr] (~500MB).
CHAN_OCR_PROVIDER=stub
CHAN_OCR_MAX_BYTES=6291456

# --- Cầu sang training plane (tuỳ chọn, cho /v1/feedback contribute) -------
# Bỏ trống thì feedback chỉ lưu verdict, không gửi gì sang training API.
# CHAN_TRAINING_API_URL=http://localhost:8001
# CHAN_TRAINING_API_KEY=

# --- Vòng đời dữ liệu (§7.2) ------------------------------------------------
CHAN_ANALYSES_RETENTION_DAYS=90
CHAN_ACCESS_LOG_RETENTION_DAYS=30

# --- Model registry ---------------------------------------------------------
# Chu kỳ hỏi bảng model_versions để hot-swap model mới.
CHAN_MODEL_POLL_SECONDS=60
