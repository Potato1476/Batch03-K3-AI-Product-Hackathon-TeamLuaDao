          "(?i)giữ\\s*b[íi]\\s*mật",
          "(?i)b[íi]\\s*mật\\s+(?:tuyệt\\s*đối|điều\\s*tra)"
        ],
        "boost_signal": "yeu_cau_bi_mat",
        "boost": 0.25
      },
      "time_pressure": {
        "patterns": [
