        "patterns": [
          "(?i)\\b(?:bit\\.ly|goo\\.gl|tinyurl\\.com|t\\.co|is\\.gd|cutt\\.ly|shorturl\\.at|rb\\.gy|rebrand\\.ly|s\\.id)\\b"
        ],
        "boost_signal": "cai_app_ngoai",
        "boost": 0.15
      },
      "apk_link": {
        "patterns": [
          "(?i)\\.apk\\b",
          "(?i)(?:tải|tai|c[àa]i|cai)\\s+(?:ứng\\s*dụng|ung\\s*dung|app|phần\\s*mềm|phan\\s*mem)\\s+(?:từ|tu|theo)\\s+(?:link|li[êe]n\\s*kết|đường\\s*dẫn)",
          "(?i)(?:bật|bat|cấp|cap)\\s+quyền\\s+(?:trợ\\s*năng|tro\\s*nang|accessibility)"
