        "(?i)\\d(?:[\\s.\\-]?\\d){3,7}\\s*(?:l[àa]\\s*)?(?:m[ãa]\\s*(?:otp|x[áa]c\\s*(?:thực|thuc|minh))|otp)",
        "(?i)(?:đọc|doc|gửi|gui|nhập|nhap|cung\\s*cấp|cung\\s*cap)\\s+(?:cho\\s+\\w+\\s+)?m[ãa]\\s*(?:otp|x[áa]c\\s*thực|x[áa]c\\s*thuc|vua\\s*gửi|vua\\s*gui)"
      ]
