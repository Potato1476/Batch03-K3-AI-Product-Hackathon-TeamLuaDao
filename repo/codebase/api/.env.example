# PostgreSQL is the live source of approved scenarios. Never point this at a
# database that is exposed directly to a client.
CHAN_DATABASE_URL=postgresql://chan:change-me@localhost:5432/chan

# Comma-separated key-id=secret entries. Use a secret manager in production.
CHAN_TRAINING_API_KEYS=feed-ingest=replace-with-random-secret-one,ml-reviewer=replace-with-random-secret-two

# These paths should be persistent object-storage mounts in production.
CHAN_MODEL_ARTIFACT_ROOT=/var/lib/chan/model-registry
CHAN_BASE_DATASET_PATH=/var/lib/chan/datasets/chan-synthetic.jsonl.gz
CHAN_GOLDEN_DATASET_PATH=/var/lib/chan/datasets/frozen-golden.jsonl.gz

# Reviewed live examples receive bounded extra weight against the large base.
CHAN_LIVE_EXAMPLE_REPEAT=10

CHAN_MINIMUM_GOLDEN_RECORDS=130
CHAN_MINIMUM_PHISHING_RECALL=0.90
CHAN_MAXIMUM_FALSE_POSITIVE_RATE=0.15
CHAN_MAXIMUM_RECALL_REGRESSION=0.02
CHAN_MAXIMUM_FALSE_POSITIVE_REGRESSION=0.02
CHAN_MINIMUM_SCENARIO_FAMILIES=20
CHAN_MINIMUM_SCENARIO_RECORDS=3
CHAN_MINIMUM_SCENARIO_RECALL=0.75
CHAN_MAXIMUM_SCENARIO_FALSE_POSITIVE_RATE=0.15
